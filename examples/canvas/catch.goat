# A catching game. Move the basket with the arrow keys or the mouse; each
# gold coin that lands in it scores a point, shown as a growing bar. Five
# points win. The coin falls on every Frame event.
init = {basket: 200, coin_x: 100, coin_y: 0, score: 0}

reach = 40
ground = 270

with_basket = program(model, to) do {basket: to, coin_x: model.coin_x, coin_y: model.coin_y, score: model.score} done

caught = program(model) do
  model.coin_x > model.basket - reach and model.coin_x < model.basket + reach
done

next_column = program(x) do if x > 300 then x - 250 else x + 70 done done

land = program(model) do
  {
    basket: model.basket,
    coin_x: next_column(model.coin_x),
    coin_y: 0,
    score: if caught(model) then model.score + 1 else model.score done
  }
done

fall = program(model, dt) do
  y = model.coin_y + 160 * dt / 1000
  if y < ground then {basket: model.basket, coin_x: model.coin_x, coin_y: y, score: model.score} else land(model) done
done

update = program(model, event) do
  match event do
    Frame(dt) then fall(model, dt)
    MouseMove(p) then with_basket(model, p.x)
    KeyPress(key) then match key do
      Left then with_basket(model, model.basket - 20)
      Right then with_basket(model, model.basket + 20)
      else model
    done
    else model
  done
done

draw = program(model) do
  [
    Box({x: model.basket - reach, y: ground, w: 2 * reach, h: 20, fill: "navy"}),
    Dot({x: model.coin_x, y: model.coin_y, r: 10, fill: "gold"}),
    Box({x: 10, y: 10, w: 20 * model.score, h: 10, fill: "green"}),
    Label({x: 10, y: 30, text: if model.score >= 5 then "you win!" else "catch the gold" done, fill: "black"})
  ]
done
