# `+ - * /` work on numbers and, field by field, on records of numbers.
start = {x: 1, y: 2}
step = {x: 10, y: 20}
moved = start + step * {x: 2, y: 2}
shown = print(moved)

# `==` compares anything with no function inside: numbers, strings, records,
# tags and lists. `print` shows any value, wherever it is in the program.
same = program(a, b) do a == b done
checks = print([same(moved, {x: 21, y: 42}), same("goat", "goat"), same([1, 2], [1, 3])])

print(moved != start)
