# A tag is declared with `tag`; capitalization is only style.
# Declarations come first and apply to the whole program. Tags declared
# together are one group, and a `match` over a group names every tag in it.
# A tag written without a payload takes whatever you give it.
tag Shape = Disc | Square
tag grey

area = program(shape) do
  match shape do
    Disc(r) then 3 * r * r
    Square(side) then side * side
  done
done

print(area(Disc(2)));
print(area(Square(3)));
match grey do
  grey then 1
done
