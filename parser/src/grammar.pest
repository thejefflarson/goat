function_lit = _{ "program" | "function" }
if_lit = _{ "if" }
then_lit = _{ "then" }
else_lit = _{ "else" }
match_lit = _{ "match" }
do_lit = _{ "do" }
done_lit = _{ "done" }
start_at_lit = _{ "start at" }
repeat_lit = _{ "repeat" }
times_lit = _{ "times" }
for_lit = _{ "for" }
and_lit = _{ "and" }
or_lit = _{ "or" }
not_lit = _{ "not" }
// `from`, `to` and `in` are only keywords inside a `for` header, so they stay
// usable as names: `line.from` and `{to: 1}` keep working. These are atomic so
// the word boundary is checked right after the word, not after skipping spaces.
for_kw = @{ for_lit ~ !XID_CONTINUE }
from_kw = @{ "from" ~ !XID_CONTINUE }
to_kw = @{ "to" ~ !XID_CONTINUE }
in_kw = @{ "in" ~ !XID_CONTINUE }
tag_kw = @{ tag_lit ~ !XID_CONTINUE }
true_lit = { "true" }
false_lit = { "false" }
boolean = { true_lit | false_lit }
return_lit = _{ "return" }
tag_lit = _{ "tag" }
// A reserved word, but only when it stands alone: the trailing `!XID_CONTINUE`
// is a word boundary, so identifiers that merely begin with a keyword — `done`
// vs `doner`, `do` vs `double`, `if` vs `ifx` — are still valid names. `done`
// is listed before `do` because PEG alternation commits to the first match,
// and `do` would otherwise shadow it.
keyword = _{
  ( function_lit
  | if_lit
  | match_lit
  | then_lit
  | else_lit
  | done_lit
  | do_lit
  | start_at_lit
  | repeat_lit
  | times_lit
  | for_lit
  | and_lit
  | or_lit
  | not_lit
  | true_lit
  | false_lit
  | return_lit
  | tag_lit
  ) ~ !XID_CONTINUE
}

equals = _{ "=" }
colon = _{ ":" }
semi = _{ ";" }
plus = { "+" }
minus = { "-" }
multiply = { "*" }
floor_divide = { "//" }
remainder = { "%" }
divide = { "/" }
equal = { "==" }
not_equal = { "!=" }
lte = { "<=" }
gte = { ">=" }
lt = { "<" }
gt = { ">" }
and_op = @{ and_lit ~ !XID_CONTINUE }
or_op = @{ or_lit ~ !XID_CONTINUE }
not_op = @{ not_lit ~ !XID_CONTINUE }
infix = _{
  and_op |
  or_op |
  plus |
  minus |
  multiply |
  floor_divide |
  divide |
  remainder |
  equal |
  not_equal |
  lte |
  lt |
  gte |
  gt
}

lparen = _{ "(" }
rparen = _{ ")" }
lbrace = _{ "{" }
rbrace = _{ "}" }
lbracket = _{ "[" }
rbracket = _{ "]" }
dot = _{ "." }
comma = _{ "," }
// No leading sign: `5 -1` is the subtraction `5 - 1`. A `.` or an exponent
// makes the literal a Float; bare digits are an Int.
number = @{ ((ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)?) | ("." ~ ASCII_DIGIT+)) ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? }

WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }

raw_string = { ("\\" ~ ANY | !"\"" ~ ANY)* }
string = @{ "\"" ~ raw_string ~ "\"" }

unicode = _{ XID_START ~ XID_CONTINUE{0, 254} }

// One lexeme for variables and tags: whether a name is a tag is decided by a
// `tag` declaration in lowering, never by its capitalization.
name = @{ !keyword ~ unicode+ }

// Actual grammar
// `tag Circle` declares a tag; `tag Shape = Circle(Number) | Dot` declares a
// closed group of them, named only when a payload refers back to it.
// Declarations come first and are hoisted: they produce no value and every tag
// is visible to the whole program.
bar = _{ "|" }
tag_decl = { tag_kw ~ (group_name ~ equals)? ~ tag_case ~ (bar ~ tag_case)* }
group_name = { name }
tag_case = { name ~ (lparen ~ type_expr ~ (comma ~ type_expr)* ~ rparen)? }
goat = { SOI ~ tag_decl* ~ expr? ~ EOI }
// `a; b` runs `a`, drops its value, and continues with `b`. The `;` is what
// keeps `f(x) (y)` and `f(x) -y` from reading as two statements: a statement
// ends only at an explicit `;`. A trailing `;` makes the whole expression `()`.
// A block is a flat run of siblings: statements, each `sequel` marking the end
// of one, and bindings, which need no `;` and bind their name for everything
// after them. So a long block or chain of bindings is a wide parse tree rather
// than a deep one.
expr = { part ~ (sequel ~ part)* ~ sequel? }
statement = _{ operand ~ more_math* }
part = _{ declaration+ ~ statement? | statement }
sequel = { semi }
operand = _{ not_op* ~ term }
more_math = _{ infix ~ operand }
// A binding's value stops at a `;`, so `x = 1; x` binds `x` for the statements
// after it instead of sequencing inside the value.
value = { operand ~ more_math* }
// `negation` keeps its operand's postfixes inside it, so `-f(x)` is `-(f(x))`.
term = _{ negation | primary ~ postfix* }
postfix = _{ access | call }
access = { dot ~ name }
call = { lparen ~ arguments? ~ rparen }
negation = { minus ~ (negation | primary ~ postfix*) }
// Order matters: pest is a PEG, so longer/more-specific alternatives come
// first. `local` (`name = ...`) begins with a name, so a bare `name` must be tried
// after it.
primary = _{ number | string | boolean | destructure | local | function | conditional | match_expr | repeat_loop | count_loop | each_loop | record | list | name | lparen ~ expr ~ rparen }
// `{...base, x: 1}`: the grammar accepts a spread anywhere so that lowering can
// say what is wrong with `{...a, ...b}`, instead of a bare parse error.
record = { lbrace ~ (record_item ~ (comma ~ record_item)* ~ comma?)? ~ rbrace }
record_item = _{ spread | field }
spread = { "..." ~ expr }
field = { name ~ colon ~ expr }
// A binding as an operand (`1 + x = 2 x`, `y = x = 2 x`) takes the rest of the
// expression as its scope, so it nests; the bindings that begin a statement are
// siblings in `part` instead.
local = { declaration ~ expr? }
declaration = { name ~ equals ~ (foreign_decl | value) ~ semi? }
// `forward = foreign "turtle" "forward" (Number) -> Unit`: a function the host
// provides. `foreign` is a keyword only here, so it stays usable as a name. The
// module and name accept any plain operand so lowering can say they must be
// string literals; the types accept every shape a host interface (WIT) has so
// lowering can say which are not supported yet.
foreign_kw = @{ "foreign" ~ !XID_CONTINUE }
foreign_decl = { foreign_kw ~ foreign_name ~ foreign_name ~ fn_type }
foreign_name = { string | number | boolean | name }
fn_type = { lparen ~ (type_expr ~ (comma ~ type_expr)* ~ comma?)? ~ rparen ~ arrow ~ type_expr }
type_expr = _{ fn_type | list_type | record_type | type_name }
list_type = { lbracket ~ type_expr ~ rbracket }
record_type = { lbrace ~ (field_type ~ (comma ~ field_type)* ~ comma?)? ~ rbrace }
field_type = { name ~ colon ~ type_expr }
type_name = @{ XID_START ~ XID_CONTINUE* }
arrow = _{ "->" }
// `{x, y} = point` and `{x, ...rest} = point`. Tried before `record`: a
// pattern has bare names where a literal has `name: value`.
destructure = { (record_pattern | list_pattern) ~ equals ~ value ~ semi? ~ expr? }
record_pattern = { lbrace ~ ((name ~ (comma ~ name)* ~ (comma ~ rest_binding)? | rest_binding) ~ comma?) ~ rbrace }
rest_binding = { "..." ~ name }
// `[]`, `[a, b]`, `[first, ...rest]`: `[` is a list pattern where a pattern is
// expected and a list literal where an expression is, so the two never meet.
// `destructure` is tried first, so `[a, b]` with no `=` after it still parses
// as a literal.
list_pattern = { lbracket ~ ((name ~ (comma ~ name)* ~ (comma ~ rest_binding)? | rest_binding) ~ comma?)? ~ rbracket }
labels = { name ~ (comma ~ name)* }
params = { param ~ (comma ~ param)* }
param = _{ record_pattern | list_pattern | name }
function = { function_lit ~ lparen ~ params? ~ rparen ~ do_lit ~ expr? ~ done_lit }
arguments = { expr ~ (comma ~ expr)* ~ comma? }
else_branch = _{ else_lit ~ expr }
conditional = { if_lit ~ expr ~ then_lit ~ expr ~ else_branch? ~ done_lit }
// A pattern head is always a tag: `Empty`, `Circle(r)`, `Link(x, rest)`.
pattern = { name ~ (lparen ~ labels? ~ rparen)? }
// `[]` is `Empty`; `[x, ...rest]` is `Link(x, rest)`; `[a, b]` is
// `Link(a, Link(b, Empty))`.
list = { lbracket ~ arguments? ~ rbracket }
// A scalar literal matches by value: `0`, `"go"`, `true`.
literal_pattern = { number | string | boolean }
arm = { (list_pattern | literal_pattern | pattern) ~ then_lit ~ expr }
match_expr = { match_lit ~ expr ~ do_lit ~ arm* ~ else_branch? ~ done_lit }
// `repeat 3 times do ... done`, `for i from 1 to 10 do ... done` (both ends
// included) and `for x in xs do ... done`. A loop is `()`.
repeat_loop = { repeat_lit ~ expr ~ times_lit ~ do_lit ~ expr? ~ done_lit }
count_loop = { for_kw ~ name ~ from_kw ~ expr ~ to_kw ~ expr ~ do_lit ~ expr? ~ done_lit }
each_loop = { for_kw ~ name ~ in_kw ~ expr ~ do_lit ~ expr? ~ done_lit }

// The token stream editors highlight from (`lexer.rs`). It reuses the lexical
// rules above and, unlike `goat`, never fails: text no rule recognizes is
// skipped one character at a time, so half-typed code still highlights. It is
// compound-atomic (`$`) so the implicit COMMENT skipping does not swallow the
// comments it exists to report, and `lex_comment` and `lex_keyword` wrap the
// silent `COMMENT` and `keyword`, which would otherwise emit no pairs.
// `from`, `to`, `in` and `foreign` are keywords only in some positions, so
// `lex_word` hands them to the lexer to place.
lex = ${ (lex_space | lex_comment | lex_string | lex_number | lex_literal | lex_keyword | lex_word | lex_name | lex_operator | lex_punct | lex_other)* ~ EOI }
lex_space = _{ WHITESPACE }
lex_comment = @{ COMMENT }
lex_string = @{ string }
lex_number = @{ number }
lex_literal = @{ (true_lit | false_lit) ~ !XID_CONTINUE }
lex_keyword = @{ keyword }
lex_word = @{ from_kw | to_kw | in_kw | foreign_kw }
lex_name = @{ name }
lex_operator = @{ equal | not_equal | lte | lt | gte | gt | arrow | floor_divide | divide | remainder | plus | multiply | minus }
lex_punct = @{ lparen | rparen | lbrace | rbrace | lbracket | rbracket | equals | colon | semi | bar | comma | "..." | dot }
lex_other = @{ ANY }
