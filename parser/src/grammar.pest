program_lit = _{ "program" }
if_lit = _{ "if" }
then_lit = _{ "then" }
else_lit = _{ "else" }
do_lit = _{ "do" }
done_lit = _{ "done" }
start_at_lit = _{ "start at" }
repeat_lit = _{ "repeat" }
times_lit = _{ "times" }
true_lit = { "true" }
false_lit = { "false" }
boolean = { true_lit | false_lit }
return_lit = _{ "return" }
// A reserved word, but only when it stands alone: the trailing `!XID_CONTINUE`
// is a word boundary, so identifiers that merely begin with a keyword — `done`
// vs `doner`, `do` vs `double`, `if` vs `ifx` — are still valid names. `done`
// is listed before `do` because PEG alternation commits to the first match,
// and `do` would otherwise shadow it.
keyword = _{
  ( program_lit
  | if_lit
  | then_lit
  | else_lit
  | done_lit
  | do_lit
  | start_at_lit
  | repeat_lit
  | times_lit
  | true_lit
  | false_lit
  | return_lit
  ) ~ !XID_CONTINUE
}

equals = _{ "=" }
colon = _{ ":" }
semi = _{ ";" }
plus = { "+" }
minus = { "-" }
multiply = { "*" }
divide = { "/" }
lte = { "<=" }
gte = { ">=" }
lt = { "<" }
gt = { ">" }
infix = _{
  plus |
  minus |
  multiply |
  divide |
  lt |
  lte |
  gt |
  gte
}

lparen = _{ "(" }
rparen = _{ ")" }
lbrace = _{ "{" }
rbrace = _{ "}" }
dot = _{ "." }
comma = _{ "," }
number = @{ "-"?
    ~ ("0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT*)
    ~ ("." ~ ASCII_DIGIT*)?
}

WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }

raw_string = { (!"\"" ~ ANY)+ }
string = @{ "\"" ~ raw_string ~ "\"" }

unicode = _{ XID_START ~ XID_CONTINUE* }

ident = @{ !keyword ~ unicode+ }

// Actual grammar
goat = { SOI ~ expr? ~ EOI }
expr = { term ~ more_math* }
more_math = _{ infix ~ term }
// A term is a primary followed by any number of postfix field accesses, so
// `.field` binds tighter than the infix operators. Because `term` and
// `primary` are both silent, a bare primary with no accesses produces exactly
// the same tree as before.
term = _{ primary ~ access* }
access = { dot ~ ident }
// Order matters: pest is a PEG, so longer/more-specific alternatives come
// first. `declaration` (`ident = ...`) and `application` (`ident(...)`) both
// begin with an identifier, so a bare `ident` must be tried last.
primary = _{ number | string | boolean | declaration | application | function | conditional | record | ident | lparen ~ expr ~ rparen }
record = { lbrace ~ (field ~ (comma ~ field)*)? ~ rbrace }
field = { ident ~ colon ~ expr }
declaration = { ident ~ equals ~ expr ~ expr? }
labels = { ident ~ (comma ~ ident)* }
function = { program_lit ~ lparen ~ labels? ~ rparen ~ do_lit ~ expr? ~ done_lit }
arguments = { expr ~ (comma ~ expr)* }
application = { ident ~ (lparen ~ arguments? ~ rparen)+ }
else_branch = _{ else_lit ~ expr }
conditional = { if_lit ~ expr ~ then_lit ~ expr ~ else_branch? ~ done_lit }
