function_lit = _{ "program" | "function" }
if_lit = _{ "if" }
then_lit = _{ "then" }
else_lit = _{ "else" }
match_lit = _{ "match" }
do_lit = _{ "do" }
done_lit = _{ "done" }
start_at_lit = _{ "start at" }
repeat_lit = _{ "repeat" }
times_lit = _{ "times" }
for_lit = _{ "for" }
and_lit = _{ "and" }
or_lit = _{ "or" }
not_lit = _{ "not" }
// `from`, `to` and `in` are only keywords inside a `for` header, so they stay
// usable as names: `line.from` and `{to: 1}` keep working. These are atomic so
// the word boundary is checked right after the word, not after skipping spaces.
for_kw = @{ for_lit ~ !XID_CONTINUE }
from_kw = @{ "from" ~ !XID_CONTINUE }
to_kw = @{ "to" ~ !XID_CONTINUE }
in_kw = @{ "in" ~ !XID_CONTINUE }
true_lit = { "true" }
false_lit = { "false" }
boolean = { true_lit | false_lit }
return_lit = _{ "return" }
// A reserved word, but only when it stands alone: the trailing `!XID_CONTINUE`
// is a word boundary, so identifiers that merely begin with a keyword — `done`
// vs `doner`, `do` vs `double`, `if` vs `ifx` — are still valid names. `done`
// is listed before `do` because PEG alternation commits to the first match,
// and `do` would otherwise shadow it.
keyword = _{
  ( function_lit
  | if_lit
  | match_lit
  | then_lit
  | else_lit
  | done_lit
  | do_lit
  | start_at_lit
  | repeat_lit
  | times_lit
  | for_lit
  | and_lit
  | or_lit
  | not_lit
  | true_lit
  | false_lit
  | return_lit
  ) ~ !XID_CONTINUE
}

equals = _{ "=" }
colon = _{ ":" }
semi = _{ ";" }
plus = { "+" }
minus = { "-" }
multiply = { "*" }
divide = { "/" }
equal = { "==" }
not_equal = { "!=" }
lte = { "<=" }
gte = { ">=" }
lt = { "<" }
gt = { ">" }
and_op = @{ and_lit ~ !XID_CONTINUE }
or_op = @{ or_lit ~ !XID_CONTINUE }
not_op = @{ not_lit ~ !XID_CONTINUE }
infix = _{
  and_op |
  or_op |
  plus |
  minus |
  multiply |
  divide |
  equal |
  not_equal |
  lte |
  lt |
  gte |
  gt
}

lparen = _{ "(" }
rparen = _{ ")" }
lbrace = _{ "{" }
rbrace = _{ "}" }
lbracket = _{ "[" }
rbracket = _{ "]" }
dot = _{ "." }
comma = _{ "," }
// No leading sign: `5 -1` is the subtraction `5 - 1`.
number = @{ (ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT*)?) | ("." ~ ASCII_DIGIT+) }

WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT = _{ "#" ~ (!NEWLINE ~ ANY)* }

raw_string = { ("\\" ~ ANY | !"\"" ~ ANY)* }
string = @{ "\"" ~ raw_string ~ "\"" }

unicode = _{ XID_START ~ XID_CONTINUE{0, 254} }

// Names split on the case of their first letter: a lowercase-initial name is a
// variable, an uppercase-initial one (Unicode `Lu`) is a variant tag.
ident = @{ !keyword ~ !UPPERCASE_LETTER ~ unicode+ }
tag_name = @{ &UPPERCASE_LETTER ~ unicode+ }

// Actual grammar
goat = { SOI ~ expr? ~ EOI }
// `a; b` runs `a`, drops its value, and continues with `b`. The `;` is what
// keeps `f(x) (y)` and `f(x) -y` from reading as two statements: a statement
// ends only at an explicit `;`. A trailing `;` makes the whole expression `()`.
expr = { operand ~ more_math* ~ sequel? }
sequel = { semi ~ expr? }
operand = _{ not_op* ~ term }
more_math = _{ infix ~ operand }
// A binding's value stops at a `;`, so `x = 1; x` binds `x` for the statements
// after it instead of sequencing inside the value.
value = { operand ~ more_math* }
// `negation` keeps its operand's postfixes inside it, so `-f(x)` is `-(f(x))`.
term = _{ negation | primary ~ postfix* }
postfix = _{ access | call }
access = { dot ~ ident }
call = { lparen ~ arguments? ~ rparen }
negation = { minus ~ (negation | primary ~ postfix*) }
// Order matters: pest is a PEG, so longer/more-specific alternatives come
// first. `declaration` (`ident = ...`) begins with an identifier, so a bare
// `ident` must be tried after it.
primary = _{ number | string | boolean | destructure | declaration | function | conditional | match_expr | repeat_loop | count_loop | each_loop | record | list | tag | ident | lparen ~ expr ~ rparen }
// `{...base, x: 1}`: the grammar accepts a spread anywhere so that lowering can
// say what is wrong with `{...a, ...b}`, instead of a bare parse error.
record = { lbrace ~ (record_item ~ (comma ~ record_item)* ~ comma?)? ~ rbrace }
record_item = _{ spread | field }
spread = { "..." ~ expr }
field = { ident ~ colon ~ expr }
declaration = { ident ~ equals ~ value ~ semi? ~ expr? }
// `{x, y} = point` and `{x, ...rest} = point`. Tried before `record`: a
// pattern has bare names where a literal has `name: value`.
destructure = { (record_pattern | list_pattern) ~ equals ~ value ~ semi? ~ expr? }
record_pattern = { lbrace ~ ((ident ~ (comma ~ ident)* ~ (comma ~ rest_binding)? | rest_binding) ~ comma?) ~ rbrace }
rest_binding = { "..." ~ ident }
// `[]`, `[a, b]`, `[first, ...rest]`: `[` is a list pattern where a pattern is
// expected and a list literal where an expression is, so the two never meet.
// `destructure` is tried first, so `[a, b]` with no `=` after it still parses
// as a literal.
list_pattern = { lbracket ~ ((ident ~ (comma ~ ident)* ~ (comma ~ rest_binding)? | rest_binding) ~ comma?)? ~ rbracket }
labels = { ident ~ (comma ~ ident)* }
params = { param ~ (comma ~ param)* }
param = _{ record_pattern | list_pattern | ident }
function = { function_lit ~ lparen ~ params? ~ rparen ~ do_lit ~ expr? ~ done_lit }
arguments = { expr ~ (comma ~ expr)* ~ comma? }
else_branch = _{ else_lit ~ expr }
conditional = { if_lit ~ expr ~ then_lit ~ expr ~ else_branch? ~ done_lit }
// `Empty`, `Circle(5)`, `Link(x, rest)`. `Empty()` is the same as `Empty`.
tag = { tag_name ~ (lparen ~ arguments? ~ rparen)? }
pattern = { tag_name ~ (lparen ~ labels? ~ rparen)? }
// `[]` is `Empty`; `[x, ...rest]` is `Link(x, rest)`; `[a, b]` is
// `Link(a, Link(b, Empty))`.
list = { lbracket ~ arguments? ~ rbracket }
arm = { (list_pattern | pattern) ~ then_lit ~ expr }
match_expr = { match_lit ~ expr ~ do_lit ~ arm* ~ else_branch? ~ done_lit }
// `repeat 3 times do ... done`, `for i from 1 to 10 do ... done` (both ends
// included) and `for x in xs do ... done`. A loop is `()`.
repeat_loop = { repeat_lit ~ expr ~ times_lit ~ do_lit ~ expr? ~ done_lit }
count_loop = { for_kw ~ ident ~ from_kw ~ expr ~ to_kw ~ expr ~ do_lit ~ expr? ~ done_lit }
each_loop = { for_kw ~ ident ~ in_kw ~ expr ~ do_lit ~ expr? ~ done_lit }
