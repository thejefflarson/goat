{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": [],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "outDir": "dist"
  },
  "include": [
    "runtime.ts",
    "compile.ts",
    "scene.ts",
    "loop.ts",
    "protocol.ts",
    "supervisor.ts",
    "worker-core.ts",
    "worker.ts",
    "input.ts",
    "stage.ts",
    "browser.ts",
    "embed.ts",
    "embed-main.ts"
  ]
}
