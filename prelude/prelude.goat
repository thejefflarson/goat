# The built-in definitions every program starts with. Each one is a `name = ...`
# binding; the program itself is the rest of the chain. Unused definitions
# cost nothing: mono only emits what the program reaches.
#
# Lists are `Empty` or `Link(head, tail)`, written `[]` and `[head, ...tail]`.
# Every function that walks a whole list keeps its recursive call in tail
# position (building results in reverse, then flipping them) so a long list
# uses constant stack.

tag Empty
tag Link

# The pieces of a dictionary (see `dict_by`) and what its `get` finds.
tag DictLeaf
tag DictNode
tag Found
tag Missing

nothing = program() do done

link = program(x, xs) do Link(x, xs) done

# Moves `xs` onto the front of `acc` one item at a time, reversing it.
reverse_onto = program(xs, acc) do
  match xs do
    [head, ...tail] then reverse_onto(tail, Link(head, acc))
    [] then acc
  done
done

reverse = program(xs) do reverse_onto(xs, []) done

add = program(xs, x) do reverse_onto(reverse(xs), [x]) done

join = program(a, b) do reverse_onto(reverse(a), b) done

length_from = program(xs, n) do
  match xs do
    [head, ...tail] then length_from(tail, n + 1)
    [] then n
  done
done

length = program(xs) do length_from(xs, 0) done

first = program(xs) do
  match xs do
    [head, ...tail] then head
    [] then trap("first of an empty list")
  done
done

rest = program(xs) do
  match xs do
    [head, ...tail] then tail
    [] then trap("rest of an empty list")
  done
done

# `item(xs, 1)` is the first item.
item = program(xs, n) do
  match xs do
    [head, ...tail] then if n == 1 then head else item(tail, n - 1) done
    [] then trap("item past the end of the list")
  done
done

each = program(xs, f) do
  match xs do
    [head, ...tail] then
      shown = f(head)
      each(tail, f)
    [] then nothing()
  done
done

change_each_onto = program(xs, f, acc) do
  match xs do
    [head, ...tail] then change_each_onto(tail, f, Link(f(head), acc))
    [] then acc
  done
done

change_each = program(xs, f) do reverse(change_each_onto(xs, f, [])) done

keep_onto = program(xs, test, acc) do
  match xs do
    [head, ...tail] then
      keep_onto(tail, test, if test(head) then Link(head, acc) else acc done)
    [] then acc
  done
done

keep = program(xs, test) do reverse(keep_onto(xs, test, [])) done

count = program(xs, test) do length(keep_onto(xs, test, [])) done

sum_from = program(xs, total) do
  match xs do
    [head, ...tail] then sum_from(tail, total + head)
    [] then total
  done
done

sum = program(xs) do sum_from(xs, 0) done

biggest_from = program(xs, best) do
  match xs do
    [head, ...tail] then biggest_from(tail, if head > best then head else best done)
    [] then best
  done
done

biggest = program(xs) do
  match xs do
    [head, ...tail] then biggest_from(tail, head)
    [] then trap("biggest of an empty list")
  done
done

smallest_from = program(xs, best) do
  match xs do
    [head, ...tail] then smallest_from(tail, if head < best then head else best done)
    [] then best
  done
done

smallest = program(xs) do
  match xs do
    [head, ...tail] then smallest_from(tail, head)
    [] then trap("smallest of an empty list")
  done
done

has = program(xs, x) do
  match xs do
    [head, ...tail] then if head == x then true else has(tail, x) done
    [] then false
  done
done

# Puts `x` before the first item of `sorted` it is smaller than; `before` holds
# the items already passed, nearest first.
insert_sorted = program(x, sorted, before) do
  match sorted do
    [head, ...tail] then
      if x < head
        then reverse_onto(before, Link(x, sorted))
        else insert_sorted(x, tail, Link(head, before))
      done
    [] then reverse_onto(before, [x])
  done
done

sort_onto = program(xs, sorted) do
  match xs do
    [head, ...tail] then sort_onto(tail, insert_sorted(head, sorted, []))
    [] then sorted
  done
done

sort = program(xs) do sort_onto(xs, []) done

sqrt = foreign "math" "sqrt" (Number) -> Number

# Drops the fraction: `truncate(-2.5)` is `-2`.
truncate = foreign "math" "truncate" (Number) -> Int

# How many bytes of UTF-8 a string holds, not how many characters: `"é"` is 2.
byte_length = foreign "text" "byte_length" (String) -> Int

# The byte (0 to 255) at a position of a string, counting from 1 like `item`.
# A position outside the string stops the program.
byte_at = foreign "text" "byte_at" (String, Int) -> Int

# How many Unicode code points a string holds: `"é"` is 1. Some things that look
# like one character are several code points: a thumbs-up with a skin tone is 2.
char_count = foreign "text" "char_count" (String) -> Int

# The code point at a position of a string, counting from 1 like `item`, as a new
# one-character string. A position outside the string stops the program.
char_at = foreign "text" "char_at" (String, Int) -> String

# The nearest whole number below: `floor(-2.5)` is `-3`.
floor = program(x) do
  whole = truncate(x)
  if whole > x then whole - 1 else whole done
done

# The nearest whole number above: `ceil(-2.5)` is `-2`.
ceil = program(x) do
  whole = truncate(x)
  if whole < x then whole + 1 else whole done
done

# The nearest whole number, halves going away from zero: `round(2.5)` is `3`
# and `round(-2.5)` is `-3`.
round = program(x) do
  whole = truncate(x)
  gap = x - whole
  if gap >= 0.5
    then whole + 1
    else if gap <= -0.5 then whole - 1 else whole done
  done
done

# Taylor series for an angle of at most 45 degrees (in radians, `t`).
sin_series = program(t) do
  t2 = t * t
  t * (1 - t2 / 6 * (1 - t2 / 20 * (1 - t2 / 42 * (1 - t2 / 72
    * (1 - t2 / 110 * (1 - t2 / 156 * (1 - t2 / 210 * (1 - t2 / 272))))))))
done

cos_series = program(t) do
  t2 = t * t
  1 - t2 / 2 * (1 - t2 / 12 * (1 - t2 / 30 * (1 - t2 / 56
    * (1 - t2 / 90 * (1 - t2 / 132 * (1 - t2 / 182 * (1 - t2 / 240)))))))
done

# Splits an angle into whole quarter turns and the at most 45 degrees left over
# (as radians), then picks the series and sign the quarter calls for. Multiples
# of 90 degrees come out exact.
sin = program(degrees) do
  quarters = round(degrees / 90)
  rest = (degrees - 90.0 * quarters) * 0.017453292519943295
  turn = quarters % 4
  if turn == 0 then sin_series(rest)
  else if turn == 1 then cos_series(rest)
  else if turn == 2 then -sin_series(rest)
  else -cos_series(rest) done done done
done

cos = program(degrees) do
  quarters = round(degrees / 90)
  rest = (degrees - 90.0 * quarters) * 0.017453292519943295
  turn = quarters % 4
  if turn == 0 then cos_series(rest)
  else if turn == 1 then -sin_series(rest)
  else if turn == 2 then -cos_series(rest)
  else sin_series(rest) done done done
done

tan = program(degrees) do sin(degrees) / cos(degrees) done

# A dictionary is an AVL tree: `DictNode(left, key, value, right, height)` or
# `DictLeaf`. Updates copy the path from the root to the change and share the
# rest, so an old dictionary is still whole and every operation takes O(log n)
# steps (`size` visits every node). `less(a, b)` says whether key `a` sorts
# before key `b`.

# The never-taken branch (a height is never negative) makes both subtrees the
# same type as the tree. Without it each function's type spells out its own
# nesting of nodes, and checking the prelude costs several times as much.
dict_height = program(tree) do
  match tree do
    DictNode(left, key, value, right, height) then
      if height < 0 then dict_height(left) + dict_height(right) else height done
    DictLeaf then 0
  done
done

dict_node = program(left, key, value, right) do
  hl = dict_height(left)
  hr = dict_height(right)
  DictNode(left, key, value, right, 1 + if hl > hr then hl else hr done)
done

# One rotation: the left (or right) child becomes the root.
dict_rotate_right = program(left, key, value, right) do
  match left do
    DictNode(ll, lk, lv, lr, lh) then dict_node(ll, lk, lv, dict_node(lr, key, value, right))
    DictLeaf then trap("dict: rotate of a leaf")
  done
done

dict_rotate_left = program(left, key, value, right) do
  match right do
    DictNode(rl, rk, rv, rr, rh) then dict_node(dict_node(left, key, value, rl), rk, rv, rr)
    DictLeaf then trap("dict: rotate of a leaf")
  done
done

# A node whose left subtree is 2 taller than its right: one rotation, or two
# when the left child leans right. `dict_lean_right` is the mirror image.
dict_lean_left = program(left, key, value, right) do
  match left do
    DictNode(ll, lk, lv, lr, lh) then
      leaning = if dict_height(lr) > dict_height(ll) then dict_rotate_left(ll, lk, lv, lr) else left done
      dict_rotate_right(leaning, key, value, right)
    DictLeaf then trap("dict: lean of a leaf")
  done
done

dict_lean_right = program(left, key, value, right) do
  match right do
    DictNode(rl, rk, rv, rr, rh) then
      leaning = if dict_height(rl) > dict_height(rr) then dict_rotate_right(rl, rk, rv, rr) else right done
      dict_rotate_left(left, key, value, leaning)
    DictLeaf then trap("dict: lean of a leaf")
  done
done

# Builds a node whose subtrees differ in height by at most 2 (what one insert
# or delete leaves), rotating when they differ by 2.
dict_balance = program(left, key, value, right) do
  hl = dict_height(left)
  hr = dict_height(right)
  if hl > hr + 1 then dict_lean_left(left, key, value, right)
  else if hr > hl + 1 then dict_lean_right(left, key, value, right)
  else dict_node(left, key, value, right) done done
done

dict_insert = program(tree, less, key, value) do
  match tree do
    DictLeaf then dict_node(DictLeaf, key, value, DictLeaf)
    DictNode(left, k, v, right, height) then
      if less(key, k)
        then dict_balance(dict_insert(left, less, key, value), k, v, right)
        else if less(k, key)
          then dict_balance(left, k, v, dict_insert(right, less, key, value))
          else DictNode(left, key, value, right, height)
        done
      done
  done
done

dict_lookup = program(tree, less, key) do
  match tree do
    DictLeaf then Missing
    DictNode(left, k, v, right, height) then
      if less(key, k) then dict_lookup(left, less, key)
      else if less(k, key) then dict_lookup(right, less, key)
      else Found(v) done done
  done
done

dict_has = program(tree, less, key) do
  match dict_lookup(tree, less, key) do
    Found(v) then true
    Missing then false
  done
done

# The leftmost node of a tree that has one.
dict_leftmost = program(tree) do
  match tree do
    DictNode(left, k, v, right, height) then
      match left do
        DictLeaf then tree
        else dict_leftmost(left)
      done
    DictLeaf then trap("dict: no smallest key")
  done
done

dict_without_leftmost = program(tree) do
  match tree do
    DictNode(left, k, v, right, height) then
      match left do
        DictLeaf then right
        else dict_balance(dict_without_leftmost(left), k, v, right)
      done
    DictLeaf then trap("dict: no smallest key")
  done
done

# Joins two trees whose keys are all ordered `left` before `right`.
dict_join = program(left, right) do
  match right do
    DictLeaf then left
    else
      match dict_leftmost(right) do
        DictNode(ml, mk, mv, mr, mh) then dict_balance(left, mk, mv, dict_without_leftmost(right))
        DictLeaf then left
      done
  done
done

dict_remove = program(tree, less, key) do
  match tree do
    DictLeaf then DictLeaf
    DictNode(left, k, v, right, height) then
      if less(key, k)
        then dict_balance(dict_remove(left, less, key), k, v, right)
        else if less(k, key)
          then dict_balance(left, k, v, dict_remove(right, less, key))
          else dict_join(left, right)
        done
      done
  done
done

dict_keys_onto = program(tree, acc) do
  match tree do
    DictLeaf then acc
    DictNode(left, k, v, right, height) then
      dict_keys_onto(left, Link(k, dict_keys_onto(right, acc)))
  done
done

dict_values_onto = program(tree, acc) do
  match tree do
    DictLeaf then acc
    DictNode(left, k, v, right, height) then
      dict_values_onto(left, Link(v, dict_values_onto(right, acc)))
  done
done

dict_size = program(tree) do
  match tree do
    DictLeaf then 0
    DictNode(left, k, v, right, height) then dict_size(left) + 1 + dict_size(right)
  done
done

dict_each = program(tree, f) do
  match tree do
    DictLeaf then nothing()
    DictNode(left, k, v, right, height) then
      before = dict_each(left, f)
      shown = f(k, v)
      dict_each(right, f)
  done
done

# A dictionary that orders its keys with `less(a, b)`. Every dictionary
# is a record with the same methods, so `set` and `remove` give back a new
# dictionary that chains: `dict().set("ana", 3).set("bo", 5)`.
dict_by = program(less) do
  {
    tree: DictLeaf,
    less: less,
    set: program(self, key, value) do
      {...self, tree: dict_insert(self.tree, self::less, key, value)}
    done,
    remove: program(self, key) do
      {...self, tree: dict_remove(self.tree, self::less, key)}
    done,
    get: program(self, key) do dict_lookup(self.tree, self::less, key) done,
    has: program(self, key) do dict_has(self.tree, self::less, key) done,
    keys: program(self) do dict_keys_onto(self.tree, []) done,
    values: program(self) do dict_values_onto(self.tree, []) done,
    size: program(self) do dict_size(self.tree) done,
    each: program(self, f) do dict_each(self.tree, f) done
  }
done

# An empty dictionary that orders its keys with `<`.
dict = program() do dict_by(program(a, b) do a < b done) done
